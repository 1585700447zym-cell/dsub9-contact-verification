{
  "version": "engineering_short_train_v1",
  "scope": "engineering_chain_only",
  "physics": {
    "backend": "native",
    "segments": 256,
    "ccd_tolerance": 1e-12,
    "timestep_s": 0.0002,
    "control_period_s": 0.002,
    "policy_period_s": 0.002
  },
  "guard": {
    "max_rotation_from_start_rad": 0.04363323129985824,
    "initial_roll_pitch_limit_rad": 0.026179938779914945
  },
  "domain": {
    "distribution": "independent_uniform_XY",
    "x_limit_m": 0.00005,
    "y_limit_m": 0.00005,
    "roll_rad": 0.0,
    "pitch_rad": 0.0,
    "start_origin_z_m": -0.004,
    "target_depth_m": 0.004
  },
  "action": {
    "scale": [
      0.00015,
      0.00015,
      0.005,
      0.005
    ],
    "enabled_stages": [
      "INSERT",
      "SEARCH"
    ]
  },
  "sampling": {
    "target_cycles": 20000,
    "stop_at": "whole_episode_audited",
    "watchdog_cycles": 13000,
    "workers": 1,
    "seed": 2026092609,
    "rng": "PCG64",
    "initial_resampling": false
  },
  "learning": {
    "learning_rate": 0.0003,
    "batch_size": 256,
    "warmup_audited_transitions": 5000,
    "replay_capacity": 100000,
    "gradient_batches_per_audited_transition": 0.25,
    "max_gradient_batches": 8250,
    "discount_time_constant_s": 10.0,
    "gamma_nominal": 0.9998000199986667,
    "discount": "exp(-actual_dt_s/10)",
    "entropy_initial": 0.01,
    "target_entropy": -4.0,
    "entropy_learned": true,
    "tau": 0.005,
    "network": [
      256,
      256
    ],
    "activation": "ReLU",
    "seed": 2026092609,
    "device": "cpu",
    "torch_threads": 1,
    "replay_publish": "whole_episode_after_audit",
    "permission_masks": "tensor_masks_v3",
    "reward": "contract_v3_unchanged"
  },
  "versions": {
    "python": "3.13.5",
    "mujoco": "3.13.0",
    "torch": "2.12.1+cpu",
    "numpy": "2.1.3",
    "gymnasium": "1.2.3",
    "stable-baselines3": "2.8.0"
  }
}
