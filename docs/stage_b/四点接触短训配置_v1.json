{
  "version": "contact_four_point_short_train_v1",
  "scope": "four_development_contact_points_only",
  "physics": {
    "backend": "native",
    "segments": 256,
    "ccd_tolerance": 1e-12,
    "timestep_s": 0.0002,
    "control_period_s": 0.002,
    "policy_period_s": 0.002
  },
  "guard": {
    "max_rotation_from_start_rad": 0.04363323129985824,
    "initial_roll_pitch_limit_rad": 0.026179938779914945
  },
  "domain": {
    "distribution": "discrete_uniform_four_points",
    "points_xy_m": [
      [
        -0.0001,
        0.0
      ],
      [
        0.0001,
        0.0
      ],
      [
        0.0,
        -0.0001
      ],
      [
        0.0,
        0.0001
      ]
    ],
    "roll_rad": 0.0,
    "pitch_rad": 0.0,
    "start_origin_z_m": -0.004,
    "target_depth_m": 0.004
  },
  "action": {
    "scale": [
      0.00015,
      0.00015,
      0.005,
      0.005
    ],
    "enabled_stages": [
      "INSERT",
      "SEARCH"
    ]
  },
  "sampling": {
    "target_cycles": 20000,
    "stop_at": "whole_episode_audited",
    "watchdog_cycles": 13000,
    "workers": 1,
    "seed": 2026092711,
    "rng": "PCG64",
    "initial_resampling": false,
    "max_attempts": 6,
    "rng_streams": {
      "case": 0,
      "warmup": 1,
      "replay": 2
    },
    "seed_rule": "PCG64/SeedSequence([seed,stream])",
    "total_audited_cycles_upper_bound": 33000
  },
  "learning": {
    "learning_rate": 0.0003,
    "batch_size": 256,
    "warmup_audited_transitions": 5000,
    "replay_capacity": 100000,
    "gradient_batches_per_audited_transition": 0.25,
    "max_gradient_batches": 8250,
    "discount_time_constant_s": 10.0,
    "gamma_nominal": 0.9998000199986667,
    "discount": "exp(-actual_dt_s/10)",
    "entropy_initial": 0.01,
    "target_entropy": -4.0,
    "entropy_learned": true,
    "tau": 0.005,
    "network": [
      256,
      256
    ],
    "activation": "ReLU",
    "seed": 2026092711,
    "device": "cpu",
    "torch_threads": 1,
    "replay_publish": "whole_episode_after_audit",
    "permission_masks": "tensor_masks_v3",
    "reward": "contract_v3_unchanged"
  },
  "versions": {
    "python": "3.13.5",
    "mujoco": "3.13.0",
    "torch": "2.12.1+cpu",
    "numpy": "2.1.3",
    "gymnasium": "1.2.3",
    "stable-baselines3": "2.8.0"
  },
  "execution": {
    "fresh_initialization": true,
    "mode_selected_at_episode_start": true,
    "freeze_actor_within_episode": true,
    "stop_on": [
      "invalid",
      "unstopped",
      "contact_guard",
      "motion_violation",
      "input_changed",
      "archive_error",
      "operator_interrupt"
    ],
    "publication": "only_complete_guard_clear_stopped_episode",
    "updates": "only_after_publication_before_next_episode",
    "checkpoint": "every_healthy_audited_episode_boundary",
    "resume": "only_verified_boundary_no_physics_resume",
    "evaluate": "four_fixed_points_once_each_deterministic",
    "baseline": "reuse_B2_06_if_common_inputs_unchanged",
    "independent_test_used": false,
    "preparation_only": true
  }
}
